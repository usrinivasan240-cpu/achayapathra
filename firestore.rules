rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Is the user logged in?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Is the user the super admin?
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "usrinivasan240@gmail.com"
      );
    }

    // Master Override: Super Admin has full access
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // Users: Profiles are restricted to the owner only.
    match /users/{userId} {
      allow get: if isAuthenticated() && (request.auth.uid == userId);
      allow create, update: if isAuthenticated() && (request.auth.uid == userId);
    }

    // NGO Demands: NGO users see their own, admins see all
    match /ngo_demands/{demandId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (
        resource.data.ngoId == request.auth.uid || isSuperAdmin()
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.ngoId == request.auth.uid || isSuperAdmin()
      );
    }

    // Donations: Readable by all, writable by owner
    match /donations/{donationId} {
      allow get, list, create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.donorId == request.auth.uid || isSuperAdmin()
      );
    }

    // System Settings: Read-only for all authenticated users
    match /system_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Admin Roles check
    match /roles_admin/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId);
    }
    
    // Feedback: Users can create suggestions
    match /feedback/{feedbackId} {
      allow create: if isAuthenticated();
      allow read: if isSuperAdmin();
    }

    // Hunger Zones: Read-only for all authenticated users
    match /hunger_zones/{zoneId} {
      allow get, list: if isAuthenticated();
    }
  }
}