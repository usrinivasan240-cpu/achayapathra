rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "usrinivasan240@gmail.com"
      );
    }

    // Super Admin has full access
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // Users: Profiles are restricted to the owner only
    match /users/{userId} {
      allow get: if isAuthenticated() && (request.auth.uid == userId);
      allow create: if isAuthenticated() && (request.auth.uid == userId);
      allow update: if isAuthenticated() && (request.auth.uid == userId);
    }

    // Donations: Readable by all authenticated users, writable by owner
    match /donations/{donationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.donorId == request.auth.uid || isSuperAdmin()
      );
    }

    // NGO Demands: NGO users see their own, admins see all
    match /ngo_demands/{demandId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.ngoId == request.auth.uid || isSuperAdmin()
      );
    }

    // System Settings: Read-only for all authenticated users
    match /system_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Admin Roles check
    match /roles_admin/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId);
      allow write: if false;
    }

    // Feedback: Users can create, admins can read
    match /feedback/{feedbackId} {
      allow create: if isAuthenticated();
      allow read: if isSuperAdmin();
    }

    // Hunger Zones: Read-only for all authenticated users
    match /hunger_zones/{zoneId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}
